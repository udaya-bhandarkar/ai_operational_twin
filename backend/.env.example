# ── Observability ────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# ── System ────────────────────────────────────────────────────────────────────
BACKEND_ENV=dev

# ── Model provider (set ONE key + matching BACKEND_MODEL string) ──────────────
#
# Anthropic (default)   → pip install langchain-anthropic  (already in deps)
ANTHROPIC_API_KEY=
BACKEND_MODEL=anthropic:claude-opus-4-8

# Groq                  → pip install ".[groq]"
# GROQ_API_KEY=
# BACKEND_MODEL=groq:llama-3.3-70b-versatile

# Mistral               → pip install ".[mistral]"
# MISTRAL_API_KEY=
# BACKEND_MODEL=mistral:mistral-large-latest
