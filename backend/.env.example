# Copy to .env and fill in. Keep comments ASCII-only (python-dotenv warns on unicode).

# --- Model provider: set ONE key and the matching BACKEND_MODEL ---------------------------
# Anthropic (core dependency)
ANTHROPIC_API_KEY=
BACKEND_MODEL=anthropic:claude-opus-4-8

# Groq - pip install ".[groq]"
# GROQ_API_KEY=
# BACKEND_MODEL=groq:llama-3.3-70b-versatile

# Mistral - pip install ".[mistral]"  (no provider prefix)
# MISTRAL_API_KEY=
# BACKEND_MODEL=mistral-large-latest

# Cheaper model from the SAME provider for summarization + dev cost routing.
# Defaults to BACKEND_MODEL when unset (no savings).
#   Anthropic: anthropic:claude-haiku-4-5 | Groq: groq:llama-3.1-8b-instant | Mistral: mistral-small-latest
# SUMMARIZATION_MODEL=

# --- Environment --------------------------------------------------------------------------
# Selects config/environments/<env>.yaml defaults. dev enables localhost CORS + budget routing.
BACKEND_ENV=dev

# --- Tools (optional) ---------------------------------------------------------------------
# Web search - pip install ".[tavily]". Empty = web_search returns a helpful message.
TAVILY_API_KEY=

# DuckDB database the agent may query (writes need human approval).
# Empty = SQL tools are not attached. Absolute path recommended.
# DUCKDB_PATH=

# --- Persistence --------------------------------------------------------------------------
# API gateway checkpoints (thread memory + paused approvals).
# Default: backend/.state/checkpoints.sqlite. Use :memory: for ephemeral threads.
# CHECKPOINT_DB=:memory:

# --- Rate limiting ------------------------------------------------------------------------
# Paces model calls under provider limits (requests/second). Default 2 suits free tiers;
# raise to 5-10 on paid tiers. 0 disables.
# MODEL_REQUESTS_PER_SECOND=2.0

# --- API gateway CORS ---------------------------------------------------------------------
# Comma-separated origins for deployed web clients. Localhost is allowed automatically in dev.
# CORS_ORIGINS=https://app.example.com
# CORS_ORIGIN_REGEX=

# --- Observability (LangSmith) ------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=general-agent
