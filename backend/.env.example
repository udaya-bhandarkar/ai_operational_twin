# Observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=RAIC

# System
BACKEND_ENV=dev

# Model provider - set ONE key and matching BACKEND_MODEL string
#
# Anthropic (default) - pip install langchain-anthropic (already in core deps)
ANTHROPIC_API_KEY=
BACKEND_MODEL=anthropic:claude-opus-4-8

# Groq - pip install ".[groq]"
# GROQ_API_KEY=
# BACKEND_MODEL=groq:llama-3.3-70b-versatile

# Mistral - pip install ".[mistral]"
# MISTRAL_API_KEY=
# BACKEND_MODEL=mistral-large-latest

# Web search (Phase 2) - pip install ".[tavily]"
# Leave empty to run in degraded mode (returns helpful error, no crash)
TAVILY_API_KEY=

# Operational database (Phase 2)
DUCKDB_PATH=data/operational.duckdb
