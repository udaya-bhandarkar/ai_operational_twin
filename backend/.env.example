# Observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=RAIC

# Environment — controls which config/environments/<env>.yaml is loaded as defaults
# dev (default): CLI HITL, budget model in dev_cost_router
# staging/prod:  API HITL, configured model used
BACKEND_ENV=dev

# Model provider - set ONE key and matching BACKEND_MODEL string
#
# Anthropic (default) - pip install langchain-anthropic (already in core deps)
#ANTHROPIC_API_KEY=
#BACKEND_MODEL=anthropic:claude-opus-4-8

# Groq - pip install ".[groq]"
GROQ_API_KEY=
BACKEND_MODEL=groq:llama-3.3-70b-versatile

# Mistral - pip install ".[mistral]"
#MISTRAL_API_KEY=
#BACKEND_MODEL=mistral-large-latest

# Context management (Phase 3)
# Model used for SummarizationMiddleware and dev cost routing.
# Defaults to BACKEND_MODEL when not set (same model, no cost savings).
# Set to a cheaper model from the SAME provider to reduce cost:
#   Anthropic: SUMMARIZATION_MODEL=anthropic:claude-haiku-4-5
#   Groq:      SUMMARIZATION_MODEL=groq:llama-3.1-8b-instant
#   Mistral:   SUMMARIZATION_MODEL=mistral-small-latest
# SUMMARIZATION_MODEL=

# Web search (Phase 2) - pip install ".[tavily]"
# Leave empty to run in degraded mode (returns helpful error, no crash)
TAVILY_API_KEY=

# Operational database (Phase 2)
DUCKDB_PATH=../data/database/operational_twin.db
