# Use built-in mock data instead of calling the backend.
# true  = develop with no backend running
# false = call the live API through the Vite proxy
VITE_USE_MOCKS=true

# How often dashboard data refreshes, in milliseconds.
# 3600000 = 1 hour. Drop to 15000 while developing to see updates faster.
VITE_REFRESH_MS=3600000

# Optional: override the API base. Leave unset to use the Vite proxy.
# VITE_API_BASE=